# Copia este archivo a `.env` y ajusta los valores.
# `.env` está en .gitignore: NUNCA lo subas al repositorio.

# --- Obligatorio en producción ----------------------------------------------
# Clave para firmar la sesión. Genera una aleatoria y larga.
TECHLOAN_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-larga

# Dirección pública con la que se construyen los enlaces de confirmación por
# correo. Debe ser la URL real del despliegue.
TECHLOAN_URL_BASE=https://tu-usuario.pythonanywhere.com

# --- Puerto y host (normalmente los inyecta la plataforma) -------------------
# TECHLOAN_PORT=8000
# TECHLOAN_HOST=0.0.0.0

# --- Correo saliente (opcional) ---------------------------------------------
# Si no se define ninguno, la aplicación entra en MODO DEMOSTRACIÓN: guarda el
# mensaje en database/buzon/ y muestra el enlace de confirmación en pantalla.
# TECHLOAN_SMTP_HOST=smtp.gmail.com
# TECHLOAN_SMTP_PORT=587
# TECHLOAN_SMTP_USER=micorreo@gmail.com
# TECHLOAN_SMTP_PASSWORD=clave-de-aplicacion
# TECHLOAN_SMTP_FROM=micorreo@gmail.com
# TECHLOAN_SMTP_TLS=1
# TECHLOAN_HORAS_TOKEN=24
